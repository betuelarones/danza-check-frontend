# =====================================================================
# DanzaCheck (frontend) - variables de entorno
#
# Copia este archivo como .env.local solo si necesitas cambiar algo.
# El archivo .env.local esta en el .gitignore: nunca se sube.
#   copy .env.example .env.local
#
# En desarrollo no hace falta configurar nada: el frontend llama a
# rutas /api/... y el proxy de Vite las reenvia a http://localhost:8080
# (ver vite.config.ts).
#
# En produccion (Vercel) SI es obligatorio: no hay proxy, asi que el
# frontend necesita la URL del backend desplejado.
# =====================================================================

# Origen del backend.
# - Vacio (valor por defecto en desarrollo): rutas relativas + proxy de
#   Vite. Es lo recomendado en local.
# - URL absoluta: obligatorio en Vercel, por ejemplo
#   https://danza-check-backend.onrender.com
#   Ese mismo origen debe estar permitido en FRONTEND_URL del backend.
VITE_API_URL=
